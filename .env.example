# Set VNC password with ./set-vnc-password.sh (stored in runtime/vnc-password).
# VNC uses only the first 8 characters. No secret is passed to Docker environment.
ATRUST_IMAGE=tingjusting/atrust:latest
# On Ubuntu 24.04 BUILD_CHROMIUM=1 installs Google Chrome official DEB (not Snap).
# Requires a browser-enabled image if CHROMIUM=1
BUILD_CHROMIUM=0
CHROMIUM=0
USE_NOVNC=
VNC_SIZE=1110x620
